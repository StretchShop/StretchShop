{
  "name": "stretchshop",
  "version": "0.7.10",
  "description": "Fast & scalable e-commerce",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/StretchShop/StretchShop.git"
  },
  "scripts": {
    "dev": "moleculer-runner --repl services",
    "dev:hot": "moleculer-runner --repl --hot services",
    "start": "moleculer-runner",
    "deps": "npm-check -u",
    "ci": "jest --watch",
    "test": "jest --coverage",
    "lint": "eslint services",
    "docker:build": "docker build -t stretchshop .",
    "demo": "node demo/demo.js",
    "postinstall": "node demo/demo.js base",
    "openapi:build": "node scripts/build-openapi-metadata.js",
    "openapi:export": "node scripts/openapi-export.js"
  },
  "keywords": [
    "stretchshop",
    "microservices",
    "moleculer",
    "e-commerce"
  ],
  "author": "Marcel Zúbrik - cw.sk",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2"
  },
  "dependencies": {
    "@spailybot/moleculer-auto-openapi": "^2.0.0",
    "@stretchshop/moleculer-cron": "^0.0.7",
    "base-64": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "connect-history-api-fallback": "^2.0.0",
    "cookie": "^2.0.1",
    "cookies": "^0.9.2",
    "cross-fetch": "^4.1.0",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.4",
    "formidable": "^3.5.4",
    "fs-extra": "^11.4.1",
    "generate-password": "^1.7.1",
    "handlebars": "^4.7.9",
    "html-to-pdfmake": "^2.5.34",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.1",
    "jsonwebtoken": "9.0.3",
    "lodash": "^4.18.1",
    "mkdirp": "^3.0.1",
    "moleculer": "^0.15.2",
    "moleculer-db": "^0.9.0",
    "moleculer-db-adapter-mongo": "^0.5.0",
    "moleculer-repl": "^0.8.0",
    "moleculer-web": "^0.11.0",
    "nats": "^2.29.3",
    "ncp": "^2.0.0",
    "node-fetch": ">=3.3.2",
    "nodemailer": "^10.0.12",
    "pdfmake": "^0.3.11",
    "promise-each": "^2.2.0",
    "saslprep": "^1.0.3",
    "slug": "^12.0.1",
    "stripe": "^22.6.2",
    "swagger-ui-dist": "^5.33.0"
  },
  "engines": {
    "node": ">= 22.23.x"
  },
  "overrides": {
    "@spailybot/moleculer-auto-openapi": {
      "moleculer": "$moleculer"
    },
    "moleculer": {
      "ioredis": "$ioredis"
    },
    "brace-expansion": "^5.0.12"
  }
}