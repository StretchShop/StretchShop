NAMESPACE=stretchshop
LOGLEVEL=info
TRANSPORTER=nats://yourNATSname:yourNATSpassword@nats-server:4222
REDIS_URL=redis://redis:6379
MONGO_URI=mongodb://yourMONGOlogin:yourMONGOpassword@mongo:27017/stretchshop?authMechanism=DEFAULT&authSource=admin
SERVICEDIR=services
CORS_ORIGIN=https://yoursite

COOKIES_SECURE=true
COOKIES_SAME_SITE=lax
# REQUIRED when NODE_ENV=production — generate with: openssl rand -hex 32
COOKIES_KEY=
#HTTPS_KEY=/app/certs/localhost.key
#HTTPS_CERT=/app/certs/localhost.crt
#HTTPS_KEY=/etc/letsencrypt/live/yoursite/privkey.pem
#HTTPS_CERT=/etc/letsencrypt/live/yoursite/cert.pem

NODE_ENV=production
IP=0.0.0.0
PORT=3000
# REQUIRED when NODE_ENV=production — generate with: openssl rand -hex 32
JWT_SECRET=
ASSETS_PATH=/var/www/html/stretchshop/static
ASSETS_URL=http://yoursite:3000/static/

SITE_URL=https://yoursite
# OpenAPI/Swagger UI is off in production. Set to true only if you need live docs.
OPENAPI_ENABLED=false
SITE_NAME=StretchShop
SITE_SUPPORT_EMAIL=support@yoursite
SITE_IMG_LOGO=logo.svg
SITE_IMG_EMAIL_HEADER=logo-words-horizontal.svg

EMAIL_DEFAULTS_FROM="StretchShop support" <support@yoursite>
EMAIL_DEFAULTS_SUBJECT='StretchShop - '
EMAIL_SMTP_HOST=smtp.ethereal.email
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_AUTH_USER=getYourEtheralAccount@ethereal.email
EMAIL_SMTP_AUTH_PASS=yourEtheralPassword
EMAIL_SMTP_CIPHERS=SSLv3

SENDING_ORDER_URL=https://orders.net/databridge/
SENDING_ORDER_PORT=1234
SENDING_ORDER_LOGIN=ordersLogin
SENDING_ORDER_PWD=ordersPassword

STRIPE_ENV=test
STRIPE_PUBLISHABLE_KEY=stripePublishableKey
STRIPE_SECRET_KEY=stripeSecretKey
STRIPE_WEBHOOK_ENDPOINT_SECRET=stripeWebhookEnpoint

RECAPTCHA_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_SECRET=recaptchaSecret
