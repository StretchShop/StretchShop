      "Page": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "abcdef1234567890"
          },
          "externalId": {
            "type": "string",
            "example": "POC1234"
          },
          "variationGroupId": {
            "type": "string",
            "example": "POC424"
          },
          "slug": {
            "type": "string",
            "example": "page-name-slug"
          },
          "publisher": {
            "type": "string",
            "example": "user@domain.tld"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Somebody Someone"
                },
                "email": {
                  "type": "string",
                  "example": "user@example.tld"
                }
              }
            }
          },
          "type": {
            "type": "string",
            "example": "page"
          },
          "subtype": {
            "type": "string",
            "example": "default"
          },
          "name": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "value": {
                "en": "Page name in English",
                "sk": "Page name in Slovak"
              }
            }
          },
          "descriptionShort": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "value": {
                "en": "Page short description in English",
                "sk": "Page short description in Slovak"
              }
            }
          },
          "descriptionLong": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "value": {
                "en": "Page long description in English",
                "sk": "Page long description in Slovak"
              }
            }
          },
          "properties": {
            "type": "object",
            "description": "Page properties"
          },
          "data": {
            "type": "object",
            "description": "Additional data for page",
            "example": {
              "value": {
                "blocks": [
                  {
                    "0": {
                      "en": "<p>English HTML block</p>",
                      "sk": "<p>Slovak HTML block</p>"
                    }
                  }
                ],
                "tagList": [
                  "example",
                  "e-commerce",
                  "extra tag"
                ]
              }
            }
          },
          "categories": {
            "type": "array",
            "description": "Array of category slugs",
            "items": {
              "type": "string"
            },
            "example": {
              "value": [
                "article-category",
                "another-article-category"
              ]
            }
          },
          "pages": {
            "type": "array",
            "description": "Array of parent pages",
            "items": {
              "type": "string"
            },
            "example": {
              "value": [
                "info",
                "business",
                "best-page"
              ]
            }
          },
          "dates": {
            "type": "object",
            "description": "Important dates of page",
            "properties": {
              "dateCreated": {
                "type": "string",
                "example": "2020-10-29T08:19:12.752+00:00"
              },
              "dateUpdated": {
                "type": "string",
                "example": "2020-10-29T08:19:12.752+00:00"
              },
              "dateSynced": {
                "type": "string",
                "example": "2020-10-29T08:19:12.752+00:00"
              }
            }
          },
          "note": {
            "type": "string",
            "description": "Notes related to product"
          },
          "activity": {
            "type": "object",
            "description": "Dates of when page starts and ends to be active",
            "properties": {
              "start": {
                "type": "string",
                "example": "2020-10-29T08:19:12.752+00:00"
              },
              "end": {
                "type": "string",
                "example": "2020-10-29T08:19:12.752+00:00"
              }
            }
          }
        }
      },
